{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/save-card",
      "destination": "/api/save-card.ts"
    },
    {
      "source": "/api/cards/:path*",
      "destination": "/api/cards.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/w/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
